# Q & M Lawncare — environment
# Copy to .env for local dev; set the same keys in Render for production.

NODE_ENV=development
PORT=3100

# Neon dashboard → the qm-lawncare project → Connection string → "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Owner portal login (/admin). Re-applied on every boot: changing
# OWNER_PASSWORD and redeploying resets the password. Minimum 10 characters.
OWNER_EMAIL=quinlanmarsh05@gmail.com
OWNER_PASSWORD=change-this-to-something-long
OWNER_NAME=Quinlan Marsh

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
